# ---------------------------------------------------------------------------
# ProcureFlow configuration
# Copy to .env and fill in values. Never commit .env.
# ---------------------------------------------------------------------------

APP_NAME=ProcureFlow
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
APP_BASE_URL=http://localhost:8000

# PostgreSQL (the Docker Compose service name is `postgres`)
POSTGRES_USER=procureflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=procureflow
DATABASE_URL=postgresql://procureflow:change-me@postgres:5432/procureflow

# Leave as `redis` when using Compose; use localhost when running locally.
REDIS_URL=redis://redis:6379/0

# LLM providers (free tiers). GROQ is tried first, Gemini is the fallback.
GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_MODEL=groq/openai/gpt-oss-120b
GEMINI_MODEL=gemini/gemini-3.5-flash
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1600
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_CACHE_TTL_SECONDS=3600

# Set to true to run entirely offline with deterministic structured outputs.
# Tests and CI always use this mode.
MOCK_LLM=false

# RAG: local sentence-transformers models (no API cost)
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_TOP_K=4
RAG_CANDIDATE_K=12
RRF_K=60
AUTO_INGEST=true

# Human-in-the-loop and workflow safety
CONFIDENCE_THRESHOLD=0.75
APPROVAL_THRESHOLD_USD=10000
MAX_GRAPH_ITERATIONS=16
CHECKPOINTER_BACKEND=postgres

# Demo budget used only when Google Sheets is not configured.
LOCAL_TOTAL_BUDGET_USD=120000
LOCAL_COMMITTED_USD=42000

# Google OAuth 2.0 + Google Sheets connector
# Authorised redirect URI: http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=Budget!A1:C10
GOOGLE_TOKEN_PATH=/data/google_token.json

# Optional LangSmith tracing. Off by default; no key is needed when disabled.
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=procureflow-langgraph-agents
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Optional CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
